# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Keep the username, password, and host private.
# In Atlas, allow this computer's IP address under Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tavelo?retryWrites=true&w=majority

# All routes are mounted under this prefix.
API_PREFIX=/api/v1

# Comma-separated browser origins. Do not use *.
# Native Expo Go requests omit Origin and are not blocked by this list.
# In development, localhost and private LAN origins are also allowed.
CORS_ORIGINS=http://localhost:8081

# Secret used to sign short-lived access tokens. At least 32 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-chars

# Access tokens last 15 minutes. Refresh tokens last 30 days and rotate on use.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Object storage (Supabase Storage). Set STORAGE_ENABLED=true after creating a private bucket.
STORAGE_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tavelo-media
SIGNED_URL_TTL_SECONDS=3600
AVATAR_MAX_BYTES=5242880
TRIP_COVER_MAX_BYTES=10485760
MEMORY_IMAGE_MAX_BYTES=15728640
MEMORY_VIDEO_MAX_BYTES=104857600
BOOKING_ATTACHMENT_MAX_BYTES=15728640

# Optional: User-Agent for Nominatim place search (https://operations.osmfoundation.org/policies/nominatim/)
# PLACE_SEARCH_USER_AGENT=Tavelo/1.0 (contact: you@example.com)

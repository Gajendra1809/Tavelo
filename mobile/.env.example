# Copy this file to mobile/.env.
# Restart Expo after changing it. These values are inlined when the app bundle starts.
#
# Physical Android phone: use this computer's Wi-Fi IPv4 address.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Android emulator: the host machine is 10.0.2.2.
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# iOS simulator on the same computer:
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#
# localhost on a phone means the phone itself, not your computer.

EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
